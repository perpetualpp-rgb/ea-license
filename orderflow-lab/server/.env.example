# copy to .env (gitignored) and fill in; never commit real values
FLOWLAB_ENV=dev
# owner role: migrations only
FLOWLAB_ADMIN_DATABASE_URL=postgresql://flowlab_owner:CHANGE_ME@127.0.0.1:5432/flowlab
# API login role (member of flowlab_app; not superuser, not owner)
FLOWLAB_DATABASE_URL=postgresql://flowlab_api:CHANGE_ME@127.0.0.1:5432/flowlab
# ingestion login role (member of flowlab_ingest)
FLOWLAB_INGEST_DATABASE_URL=postgresql://flowlab_ingestor:CHANGE_ME@127.0.0.1:5432/flowlab
# dev/test HS256 secret, at least 32 bytes (production must verify the IdP's JWKS instead)
FLOWLAB_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_32_BYTES_OR_MORE
FLOWLAB_JWT_ISSUER=flowlab-dev
FLOWLAB_JWT_AUDIENCE=flowlab-api
FLOWLAB_DELAY_MINUTES=15
FLOWLAB_DEFAULT_ENTITLEMENT=delayed
FLOWLAB_CORS_ORIGINS=
FLOWLAB_DB_OWNER_PASSWORD=CHANGE_ME
